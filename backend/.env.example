# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Atlas or Local)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/gold_emi_db?retryWrites=true&w=majority

# JWT Secrets & Expiry
JWT_ACCESS_SECRET=your_jwt_access_secret_key_minimum_32_chars_long
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_minimum_32_chars_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Initial Admin Seed Credentials
ADMIN_NAME=Fintech Administrator
ADMIN_EMAIL=admin@goldloan.internal
ADMIN_PASSWORD=AdminSecurePassword123!

# Stakeholder Visibility Flags
# If true, administrators can inspect settled input parameters of calculations. If false, only result summaries are shown.
ADMIN_VIEW_RAW_INPUTS=true

# Activity Logging Retention Period (in seconds; 31536000 seconds = 365 days / 12 months)
ACTIVITY_RETENTION_SECONDS=31536000

# Gold Data Provider API Key (e.g. GoldAPI.io or Metals-Dev)
GOLD_API_KEY=your_optional_gold_api_key_here
GOLD_API_PROVIDER=wgc_lbma_official
