{
  "name": "gold-loan-calculator-suite",
  "version": "1.0.0",
  "description": "Production-quality Gold & Loan Calculator Mobile Application with Node.js/MongoDB Backend and Shared Calc Engine",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --testPathPattern=\"(tests/calc|backend/tests|tests/mobile)\" --runInBand",
    "test:calc": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --testPathPattern=tests/calc",
    "test:backend": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --testPathPattern=backend/tests --runInBand",
    "test:mobile": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --testPathPattern=tests/mobile",
    "test:all": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --testPathPattern=\"(tests/calc|backend/tests|tests/mobile)\" --runInBand",
    "start:backend": "cd backend && npm run dev",
    "start:mobile": "cd mobile && npx expo start --android",
    "android": "cd mobile && npx expo start --android"
  },
  "devDependencies": {
    "jest": "^29.7.0"
  }
}
