{
  "name": "gold-emi-backend",
  "version": "1.0.0",
  "description": "Backend API for Gold & Loan Mobile Application",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed:admin": "node scripts/seedAdmin.js",
    "seed:lenders": "node scripts/seedLenders.js",
    "backfill": "node scripts/backfillGoldHistory.js",
    "test": "node --experimental-vm-modules ../node_modules/jest/bin/jest.js --testPathPattern=tests --runInBand"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.1.3",
    "supertest": "^7.0.0"
  }
}
