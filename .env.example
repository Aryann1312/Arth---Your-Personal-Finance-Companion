# =================================================================
# Arth / Gold & Loan Ecosystem — Environment Configuration
# =================================================================

# Backend API Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Atlas or Local Replica Set)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/gold_emi_db?retryWrites=true&w=majority

# JWT Authentication Secrets
JWT_ACCESS_SECRET=your_jwt_access_secret_key_minimum_32_chars_long
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_minimum_32_chars_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Initial Administrator Seed
ADMIN_NAME=Fintech Administrator
ADMIN_EMAIL=admin@goldloan.internal
ADMIN_PASSWORD=AdminSecurePassword123!

# Mobile App Environment
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:5000/api
