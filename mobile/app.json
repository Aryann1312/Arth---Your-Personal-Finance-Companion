{
  "expo": {
    "name": "Arth",
    "slug": "gold-loan-calculator-suite",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.goldloan.calculator",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FAF8F5"
      }
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FAF8F5"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "5dc24779-7428-40ad-8253-e5f239ef4fed"
      }
    },
    "owner": "aryann13"
  }
}